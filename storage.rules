rules_version = '2';
// Firebase 콘솔 → Storage → 규칙(Rules) 탭에 붙여넣고 '게시'.
// ⚠️ 두 이메일을 firebase-config.js의 ALLOWED_EMAILS와 똑같이 맞추세요.
service firebase.storage {
  match /b/{bucket}/o {
    match /rooms/{room}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'synik3918@gmail.com',      // 서영님
          'shinkoo.yoon@gmail.com'    // 지인
        ];
    }
  }
}
