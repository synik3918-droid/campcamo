rules_version = '2';
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 붙여넣고 '게시'.
// ⚠️ 아래 두 이메일을 firebase-config.js의 ALLOWED_EMAILS와 똑같이 맞추세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email in [
          'synik3918@gmail.com',      // 서영님
          'shinkoo.yoon@gmail.com'    // 지인
        ];
    }

    // 메시지 (텍스트/이미지 둘 다)
    match /rooms/{room}/messages/{msg} {
      allow read, create: if allowed();
      allow update, delete: if false;
    }

    // 읽음 표시 (각자 자기 read 문서 갱신)
    match /rooms/{room}/reads/{who} {
      allow read, write: if allowed();
    }
  }
}
